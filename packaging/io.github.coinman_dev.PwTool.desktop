[Desktop Entry]
Type=Application
Name=Password Tool
GenericName=Password Generator
GenericName[de]=Passwort-Generator
GenericName[ru]=Генератор паролей
Comment=Generate secure passwords and manage them in encrypted databases
Comment[de]=Sichere Passwörter erzeugen und in verschlüsselten Datenbanken verwalten
Comment[ru]=Создание надёжных паролей и хранение их в зашифрованных базах
Exec=pwtool
Icon=io.github.coinman_dev.PwTool
Terminal=false
Categories=Utility;Security;
Keywords=password;generator;passphrase;manager;security;
Keywords[ru]=пароль;генератор;парольная фраза;менеджер паролей;безопасность;
StartupNotify=true
StartupWMClass=io.github.coinman_dev.PwTool
